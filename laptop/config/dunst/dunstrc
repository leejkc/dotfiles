[global]
monitor = 0
follow = none
width = 450
height = (0, 300)
origin = top-right
offset = (20, 20)
scale = 0
notification_limit = 10

progress_bar = true
progress_bar_height = 12
progress_bar_frame_width = 1
progress_bar_min_width = 325
progress_bar_max_width = 325
progress_bar_corner_radius = 6
progress_bar_corners = all
icon_corner_radius = 6
icon_corners = all

indicate_hidden = yes
separator_height = 2
padding = 8
horizontal_padding = 16
text_icon_padding = 0
frame_width = 1
frame_color = "#4C566A"
gap_size = 10
separator_color = frame
sort = urgency_descending

font = Google Sans Code 11
line_height = 2
markup = full
format = "<b>%s</b>\n%b\n<b>From: %a</b>"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes

enable_recursive_icon_lookup = true
icon_theme = Papirus-Dark
icon_position = left
min_icon_size = 32
max_icon_size = 75
sticky_history = yes
history_length = 20

dmenu = /usr/bin/rofi -show drun -show-icons -icon-theme Papirus-Dark -p "Search notifications"
browser = /usr/bin/google-chome-stable
always_run_script = true
title = Dunst
class = Dunst
corner_radius = 10
corners = all
ignore_dbusclose = false
force_xwayland = false
force_xinerama = false

mouse_left_click = close_current
mouse_middle_click = close_all
mouse_right_click = do_action, open_url

[experimental]
per_monitor_dpi = false

[urgency_low]
background = "#434c5e"
foreground = "#d8dee9"
frame_color = "#d8dee9"
timeout = 5
default_icon = dialog-information

[urgency_normal]
background = "#434c5e"
foreground = "#e5e9f0"
frame_color = "#e5e9f0"
timeout = 5
override_pause_level = 30
default_icon = dialog-information

[urgency_critical]
background = "#434c5e"
foreground = "#bf616a"
frame_color = "#bf616a"
timeout = 0
override_pause_level = 60
default_icon = dialog-warning

[volume]
appname = volume
background = "#3B4252E6"
foreground = "#ECEFF4"
frame_color = "#5E81AC"
format = "🔊 %p%%"
timeout = 2
icon_position = left
skip_display = false

[brightness]
appname = brightness
background = "#3B4252E6"
foreground = "#ECEFF4"
frame_color = "#5E81AC"
format = "💡 %p%%"
timeout = 2
icon_position = left
skip_display = false

[backlight]
appname = backlight
background = "#3B4252E6"
foreground = "#ECEFF4"
frame_color = "#5E81AC"
format = "⌨️ %p%%"
timeout = 2
icon_position = left
skip_display = false
