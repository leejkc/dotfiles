
set $terminal foot
set $ezterminal foot -e zsh
set $fileManager "$terminal yazi"
set $menu fuzzel
set $browser firefox
set $ide code

#============OUTPUTS============

# Laptop screen
output eDP-1 mode 1920x1080@120Hz
output eDP-1 pos 0 0 scale 1

# HDMI right of laptop
output HDMI-A-1 mode 1920x1080@240Hz
output HDMI-A-1 pos 1920 0 scale 1

# DP right of laptop
output DP-1 mode 1920x1080@60Hz
output DP-1 pos 1920 0 scale 1

# output mapping
#workspace 1 output eDP-1
#workspace 2 output eDP-1
#workspace 3 output eDP-1
#workspace 4 output eDP-1
#workspace 5 output eDP-1
#workspace 6 output eDP-1
#workspace 7 output eDP-1
#workspace 8 output eDP-1
#workspace 9 output eDP-1
#workspace 10 output eDP-1

xwayland enable

for_window [app_id=".*"] floating enable, border normal 2

#============INPUTS============

input "type:keyboard" {
    xkb_layout us
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    drag_lock disabled
    middle_emulation enabled
    natural_scroll disabled
    scroll_factor 1
    accel_profile flat
    pointer_accel 1.0
}

#============LOOK============

default_border pixel 1
default_floating_border pixel 1

# class                 border  backgr. text    indicator child_border
client.focused          #a7c080 #a7c080 #232a2e #a7c080
client.focused_inactive #a7c080 #a7c080 #232a2e #a7c080
client.unfocused        #d3c6aa #d3c6aa #232a2e #d3c6aa
client.urgent           #e67e80 #e67e80 #232a2e #e67e80

#============AUTOSTART============

exec_always --no-startup-id seat * xcursor_theme default 18

exec_always --no-startup-id swaybg -i /home/lee/Pictures/henrietta-ronner-knip.jpg -m fill
exec_always --no-startup-id dunst
exec_always --no-startup-id yambar
exec_always --no-startup-id blueman-applet
exec_always --no-startup-id pipewire

#============KEYBINDS============

set $mod Mod4

set $left Left
set $down Down
set $up Up
set $right Right

floating_modifier $mod normal
tiling_drag enabled

bindsym $mod+k exec $terminal
bindsym $mod+Return exec $ezterminal
bindsym $mod+q kill
bindsym $mod+m exit
bindsym $mod+l exec swaylock 
bindsym $mod+e exec $fileManager
bindsym $mod+space floating toggle
bindsym $mod+r exec $menu
bindsym $mod+Shift+r exec $windows
bindsym $mod+i layout toggle splitv splith
bindsym $mod+o layout toggle tabbed splith

bindsym $mod+w exec $browser
bindsym $mod+Shift+w exec $browser -private-window
bindsym $mod+x exec moonlight-stable
bindsym $mod+a exec steam
bindsym $mod+s exec spotify
bindsym $mod+d exec github-desktop
bindsym $mod+g exec grim -g "$(slurp -d)" - | tee "$HOME/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png"
bindsym Print exec grim -g "$(slurp -d)" - | tee "$HOME/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png"
bindsym $mod+b exec blueman-manager
bindsym $mod+c exec $ide

# focus
bindsym $mod+$left  focus left
bindsym $mod+$right focus right
bindsym $mod+$up    focus up
bindsym $mod+$down  focus down

# move focused
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# workspaces 1–10
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# volume keys
bindsym XF86AudioRaiseVolume exec vol.sh up
bindsym XF86AudioLowerVolume exec vol.sh down
bindsym XF86AudioMute        exec vol.sh mute

# brightness keys
bindsym XF86MonBrightnessUp   exec bright.sh up
bindsym XF86MonBrightnessDown exec bright.sh down
bindsym XF86KbdBrightnessUp   exec bright.sh kbd

# playerctl
bindsym XF86AudioNext  exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay  exec playerctl play-pause
bindsym XF86AudioPrev  exec playerctl previous
